# TypeTrace Playwright environment
# Copy this file to .env.e2e and configure dedicated local test accounts.
# Never place real credentials in this example file.

E2E_FRONTEND_URL=http://127.0.0.1:5174
E2E_BACKEND_URL=http://127.0.0.1:8010
E2E_START_SERVERS=true
E2E_REUSE_EXISTING_SERVERS=false

# Dedicated verified accounts from the local E2E database.
E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=
E2E_TEACHER_EMAIL=
E2E_TEACHER_PASSWORD=

# Optional read-only fixtures.
E2E_SESSION_ID=
E2E_CERTIFICATE_ID=

# Keep disabled during ordinary test runs.
E2E_MUTATING_WORKFLOW=false
E2E_COURSE_INVITE_CODE=
