# TypeTrace local environment example
# Copy to .env and replace every placeholder. Never commit the real .env.

ENVIRONMENT=development
APP_NAME=TypeTrace API
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
ENABLE_API_DOCS=true
LOG_LEVEL=INFO

SECRET_KEY=replace-with-at-least-32-random-characters
ALGORITHM=HS256
JWT_ISSUER=typetrace-api
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RESET_TOKEN_EXPIRE_MINUTES=15

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/typetrace
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SECURITY_HEADERS_ENABLED=true
ENABLE_HSTS=false
HSTS_MAX_AGE_SECONDS=31536000

MAX_LOGIN_ATTEMPTS_PER_MINUTE=8
MAX_OTP_ATTEMPTS_PER_MINUTE=6
MAX_PUBLIC_VERIFY_PER_MINUTE=30
RATE_LIMIT_STORAGE_URI=memory://

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_MASTER_KEY=replace-with-a-fernet-key

# Enable only while reading/migrating old plaintext or former development-key data.
ALLOW_LEGACY_EVIDENCE_DECRYPTION=false

PUBLIC_CERTIFICATE_SHOW_STUDENT_NAME=false
PUBLIC_CERTIFICATE_SHOW_STUDENT_ID=false
PUBLIC_CERTIFICATE_PDF_SHOW_STUDENT_ID=false
DATA_EXPORT_INCLUDE_SENSITIVE_BY_DEFAULT=false

CERTIFICATE_SIGNING_KEY_ID=typetrace-local-v1
CERTIFICATE_SIGNING_PRIVATE_KEY=
CERTIFICATE_SIGNING_PUBLIC_KEY=
CERTIFICATE_SIGNING_HMAC_SECRET=
CERTIFICATE_ALLOW_HMAC_FALLBACK=true
ALLOW_MODEL_RELOAD=false

# Production overrides:
# ENVIRONMENT=production
# ENABLE_API_DOCS=false
# ENABLE_HSTS=true
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379/1
# CERTIFICATE_ALLOW_HMAC_FALLBACK=false
