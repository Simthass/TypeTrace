# =============================================================================
# TypeTrace Environment Template
# Copy this file to .env before running the project locally.
# =============================================================================

# Application
ENVIRONMENT=development
APP_NAME=TypeTrace API
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Security
# For local development, generate with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-this-with-a-long-random-secret-key
ALGORITHM=HS256
JWT_ISSUER=typetrace-api
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RESET_TOKEN_EXPIRE_MINUTES=15

SECURITY_HEADERS_ENABLED=true
ENABLE_HSTS=false
HSTS_MAX_AGE_SECONDS=31536000

MAX_LOGIN_ATTEMPTS_PER_MINUTE=8
MAX_OTP_ATTEMPTS_PER_MINUTE=6
MAX_PUBLIC_VERIFY_PER_MINUTE=30

# Privacy
PUBLIC_CERTIFICATE_SHOW_STUDENT_NAME=true
PUBLIC_CERTIFICATE_SHOW_STUDENT_ID=false
PUBLIC_CERTIFICATE_PDF_SHOW_STUDENT_ID=false
DATA_EXPORT_INCLUDE_SENSITIVE_BY_DEFAULT=false

# Database
POSTGRES_USER=typetrace_admin
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=typetracedb
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://typetrace_admin:replace_with_local_password@localhost:5432/typetracedb

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email / OTP
# Configure these only if email sending is enabled in your local environment.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=
MAIL_STARTTLS=true
MAIL_SSL_TLS=false


# Certificate signing ledger
# Generate Ed25519 keys with: python backend/scripts/generate_signing_key.py
CERTIFICATE_SIGNING_KEY_ID=typetrace-local-v1
CERTIFICATE_SIGNING_PRIVATE_KEY=
CERTIFICATE_SIGNING_PUBLIC_KEY=
CERTIFICATE_SIGNING_HMAC_SECRET=
CERTIFICATE_ALLOW_HMAC_FALLBACK=true
